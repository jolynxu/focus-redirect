{
  "manifest_version": 3,
  "name": "Focus Redirect",
  "version": "1.0.1",
  "description": "Redirects you back to your work pages when you wander onto distracting sites.",
  "permissions": ["storage", "tabs", "webNavigation", "alarms"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "Focus Redirect" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": { "id": "focus-redirect@local", "strict_min_version": "115.0" }
  }
}
