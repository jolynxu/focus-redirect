{
  "manifest_version": 3,
  "name": "Focus Redirect",
  "version": "1.0.1",
  "description": "Redirects you back to your work pages when you wander onto distracting sites.",
  "permissions": ["storage", "tabs", "webNavigation", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Focus Redirect" },
  "options_page": "options.html"
}
